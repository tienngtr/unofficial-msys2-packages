pkgname=coccinelle
pkgver=1.3.1
pkgrel=1
pkgdesc='Program matching and transformation engine for C'
arch=('x86_64')
url='https://coccinelle.gitlabpages.inria.fr/website/'
license=('GPL2')
depends=('python' 'pcre')
makedepends=('autoconf' 'automake' 'gcc' 'make' 'ocaml' 'ocaml-findlib' 'patch' 'pcre-devel' 'pkgconf')
source=(
  "https://github.com/coccinelle/coccinelle/archive/refs/tags/${pkgver}.tar.gz"
  '001-coccinelle-msys2-build.patch'
)
sha256sums=(
  '85989b37a2b37c37f62ae9576042c0c812908f97dac76ecbbdc9707225aced79'
  'b65ed5ba266ea3fde39fd7a1f9857d97f3b359bf908bd68e5581cd3c65d791ca'
)

prepare() {
  cd "${srcdir}/coccinelle-${pkgver}"
  patch -Np1 -i "${srcdir}/001-coccinelle-msys2-build.patch"
  ./autogen
  ( cd bundles/stdcompat/stdcompat-current && autoreconf -fi )
}

build() {
  cd "${srcdir}/coccinelle-${pkgver}"
  ./configure \
    --prefix=/usr \
    --with-python=/usr/bin/python \
    --enable-python \
    --enable-pcre-syntax \
    --with-bash-completion=/usr/share/bash-completion/completions
  make
}

check() {
  cd "${srcdir}/coccinelle-${pkgver}"
  # The complete upstream suite includes OCaml scripting tests.  OCaml
  # scripting is intentionally not enabled by the MSYS2 build; the project's
  # installed-package tests cover the supported Python/PCRE/core behavior.
  ./spatch.opt --version | grep -F "${pkgver}"
}

package() {
  cd "${srcdir}/coccinelle-${pkgver}"
  make DESTDIR="${pkgdir}" install

  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
  install -m644 license.txt "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
